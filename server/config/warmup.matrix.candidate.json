{
  "version": "1.0.0-candidate",
  "description": "Matrice candidate A/B — T1 qwen3.5:2b + T2 granite4.1:8b (experts T3 = copie baseline, hors critères)",
  "experiment": "candidate",
  "doctrine": {
    "max_concurrent_experts": 2,
    "max_vram_gb": 20,
    "tier1_only_at_boot": true,
    "tier2_deferred": true
  },
  "tiers": {
    "tier1": {
      "label": "CRITIQUE — Chat rapide candidat (boot)",
      "timeout": 120000,
      "models": [
        {
          "id": "qwen3.5:2b",
          "role": "chat",
          "mode": "single",
          "best_effort": true,
          "profiles": {
            "reactive": { "mode": "single" },
            "balanced": { "mode": "single" },
            "fast": { "mode": "single" }
          },
          "vram_gb": 2.7,
          "priority": 1,
          "context_gb_per_8k": 0.4
        },
        {
          "id": "nomic-embed-text:latest",
          "role": "embeddings",
          "mode": "single",
          "vram_gb": 0.3,
          "priority": 1,
          "context_gb_per_8k": 0.1
        }
      ]
    },
    "tier2": {
      "label": "Tier 2 différé — granite4.1:8b (reasoner on demand)",
      "timeout": 180000,
      "lazy": true,
      "defer_at_boot": true,
      "models": [
        {
          "id": "granite4.1:8b",
          "role": "reasoner",
          "mode": "single",
          "best_effort": true,
          "vram_gb": 5.3,
          "priority": 2,
          "context_gb_per_8k": 0.8
        }
      ]
    },
    "tier3": {
      "label": "EXPERTS — Lazy-loaded (copie baseline, hors critères A/B)",
      "timeout": 180000,
      "lazy": true,
      "models": [
        {
          "id": "qwen2.5-coder:7b",
          "role": "coding",
          "expert": "builder",
          "mode": "single",
          "vram_gb": 4.7,
          "priority": 3,
          "context_gb_per_8k": 1
        },
        {
          "id": "gemma4:12b",
          "role": "vision",
          "expert": "vision",
          "mode": "single",
          "vram_gb": 7.6,
          "priority": 3,
          "context_gb_per_8k": 1
        },
        {
          "id": "glm-ocr:q8_0",
          "role": "ocr",
          "expert": "ocr",
          "mode": "single",
          "vram_gb": 1.6,
          "priority": 3,
          "context_gb_per_8k": 1
        },
        {
          "id": "deepseek-ocr:latest",
          "role": "ocr",
          "expert": "ocr_fallback",
          "mode": "single",
          "vram_gb": 6.7,
          "priority": 4,
          "context_gb_per_8k": 1
        },
        {
          "id": "nexxus-vox:latest",
          "role": "voice",
          "expert": "vox",
          "mode": "single",
          "vram_gb": 0.5,
          "priority": 3,
          "context_gb_per_8k": 0.2
        }
      ]
    }
  },
  "settings": {
    "priming": {
      "ping": {
        "num_predict": 1,
        "prompt": "Ping",
        "num_ctx": 2048,
        "keep_alive": "30m"
      },
      "sense": {
        "num_predict": 8,
        "prompt": "Bonjour Nexxus. Es-tu prêt ?",
        "num_ctx": 2048,
        "keep_alive": "30m"
      }
    },
    "fallback": {
      "enabled": true,
      "default_reasoner": "granite4.1:8b",
      "default_chat": "qwen3.5:2b",
      "default_coder": "qwen2.5-coder:7b",
      "default_coder_alternative": null,
      "default_chat_alternative_multimodal": "qwen3.5:9b",
      "default_vision": "gemma4:12b"
    }
  }
}
