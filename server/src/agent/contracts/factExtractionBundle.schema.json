{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factExtractionBundle.schema.json",
  "title": "FactExtractionBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extraction_id",
    "query_id",
    "status",
    "facts",
    "hypotheses",
    "missing_proof",
    "unknowns"
  ],
  "properties": {
    "extraction_id": {
      "type": "string",
      "minLength": 1
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "needs_clarification",
        "insufficient_evidence",
        "failed"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "statement",
          "classification",
          "evidence_ids",
          "derivation",
          "confidence"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 5
          },
          "classification": {
            "type": "string",
            "enum": ["confirmed"]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "derivation": {
            "type": "string",
            "enum": [
              "direct_observation",
              "explicit_log_statement",
              "explicit_code_statement",
              "explicit_db_result",
              "explicit_doc_statement"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "statement",
          "classification",
          "based_on_fact_ids",
          "missing_proof",
          "confidence"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 5
          },
          "classification": {
            "type": "string",
            "enum": ["probable"]
          },
          "based_on_fact_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "missing_proof": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "missing_proof": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "reason",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  }
}
