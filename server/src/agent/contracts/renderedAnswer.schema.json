{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "renderedAnswer.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["rendered_text", "tone"],
  "properties": {
    "rendered_text": {
      "type": "string",
      "minLength": 5
    },
    "tone": {
      "type": "string",
      "enum": ["direct", "structured", "cautious", "disambiguation"]
    }
  }
}
