{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hypothesisRecord.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["hypothesis_id", "statement", "classification", "based_on_fact_ids", "missing_proof"],
  "properties": {
    "hypothesis_id": { "type": "string" },
    "statement": { "type": "string" },
    "classification": { "type": "string", "enum": ["probable"] },
    "based_on_fact_ids": { 
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_proof": { 
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "owner_agent": { "type": "string" }
  }
}
