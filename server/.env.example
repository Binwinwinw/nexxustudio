# Copier vers server/.env et renseigner les valeurs (ne jamais commiter server/.env)

# Obligatoires (fail-closed au démarrage)
JWT_SECRET=
INTERNAL_API_TOKEN=
LOG_ENCRYPTION_KEY=

# Auth console admin (distinct du token interne en production)
ADMIN_PASSWORD=

# Serveur
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Base de données (optionnel en local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nexxus

# Logs
ALLOW_LEGACY_PLAINTEXT_LOGS=false

# LLM
OLLAMA_HOST=http://127.0.0.1:11434

# Vision / OCR (Tier 3 lazy — chat avec image jointe ou POST /api/vision/analyze)
# Modèles Ollama requis : gemma4:12b (primaire), deepseek-ocr:latest (OCR + fallback vision)
# ollama pull gemma4:12b
# ollama pull deepseek-ocr:latest
NEXXUS_VISION_OCR=1
# NEXXUS_VISION_MODEL=gemma4:12b
# NEXXUS_VISION_OCR_MODEL=deepseek-ocr:latest
# NEXXUS_VISION_FALLBACK_MODEL=deepseek-ocr:latest
# NEXXUS_VISION_NUM_PREDICT=1024
# Ne pas lister skill-vision-sota dans SKILLS_DISABLED

# Capability packs — formulation Caveman LITE sur tours techniques (REPO/code) sans mot « caveman » dans le chat
# NEXXUS_LOW_TOKEN_MODE=1

# OCR documentaire — micro-service Unlimited-OCR (voir ocr-service/ et docs/agents/unlimited-ocr-integration-v1.md)
# OCR_SERVICE_URL=http://127.0.0.1:8765
# OCR_SERVICE_TIMEOUT_MS=120000
# OCR_SERVICE_ASSUME_READY=1
# OCR_MAX_PAGES_DEFAULT=40
