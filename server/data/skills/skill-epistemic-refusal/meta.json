        "salut",
        "bonjour",
        "bonsoir",
        "coucou",
        "hey",
        "hello",
        "comment ça va",
        "ça va"
      ]
    },
    {
      "type": "queryContains",
      "patterns": [
        "qui es-tu",
        "qui êtes-vous",
        "qui tu es",
        "présente-toi",
        "présente toi",
        "ton nom",
        "ta name",
        "votre nom"
      ]
    },
    {
      "type": "intentId",
      "value": "intent-greeting"
    },
    {
