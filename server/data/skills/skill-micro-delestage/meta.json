    "micro délestage",
    "intentShortCircuit",
    "runConversationShortCircuit",
    "familiarity_deterministic",
    "ideation_deterministic",
    "social_deterministic",
    "surfaceFormNormalizer",
    "identityIntentGuards",
    "familiarityIntentGuards",
    "interpretRequest",
    "request_interpreter_clarify"
  ],
  "runtimeModules": [
    {
      "path": "server/src/agent/micro/index.js",
      "exportName": "runConversationShortCircuit",
      "required": true,
      "status": "implemented"
    },
    {
      "path": "server/src/agent/micro/classifiers/intentShortCircuit.js",
      "exportName": "runConversationShortCircuit",
      "required": true,
      "status": "implemented"
    },
    {
      "path": "server/src/agent/utils/familiarityIntentGuards.js",
      "exportName": "getFamiliarityDeterministicReply",
      "required": false,
      "status": "implemented"
    }
  ],
  "testFiles": [
    "server/tests/micro-conversation-shortcircuit.test.js",
    "server/tests/agent-social-identity.test.js",
    "server/tests/agent-ideation-contract.test.js",
    "server/tests/agent-familiarity-contract.test.js",
    "server/tests/subject-understanding.test.js",
    "server/tests/lexicon-learning.test.js",
    "server/tests/subject-deepening-p3.test.js",
    "server/tests/request-interpreter-p4.test.js"
  ],
  "vaultRefs": [
