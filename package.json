{
  "name": "nexxustudio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "cd server && npm run dev",
    "airllm": "cd server/airllm && python airllm_server.py",
    "creative": "cd server/creative && venv\\Scripts\\python.exe creative_server.py",
    "chroma": ".venv\\Scripts\\chroma.exe run --host 127.0.0.1 --port 8008 --path server/data/chroma",
    "prestart": "powershell -ExecutionPolicy Bypass -File ./scripts/cleanup-ports.ps1",
    "purge:dry-run": "powershell -ExecutionPolicy Bypass -File ./scripts/purge-repo-junk.ps1 -Wave 1",
    "purge:dry-run:all": "powershell -ExecutionPolicy Bypass -File ./scripts/purge-repo-junk.ps1 -Wave all",
    "purge:wave1": "powershell -ExecutionPolicy Bypass -File ./scripts/purge-repo-junk.ps1 -Wave 1 -Execute",
    "start": "npm run start:balanced",
    "start:fast": "set OLLAMA_BOOT_PROFILE=fast && set OLLAMA_MAX_LOADED_MODELS=2 && concurrently --kill-others --restart-tries 3 --restart-delay 5000 \"npm run server\" \"npm run dev\" \"npm run airllm\" \"npm run creative\" \"npm run chroma\"",
    "start:balanced": "set OLLAMA_BOOT_PROFILE=balanced && set OLLAMA_MAX_LOADED_MODELS=2 && concurrently --kill-others --restart-tries 3 --restart-delay 5000 \"npm run server\" \"npm run dev\" \"npm run airllm\" \"npm run creative\" \"npm run chroma\"",
    "start:demo": "set OLLAMA_BOOT_PROFILE=demo && set OLLAMA_MAX_LOADED_MODELS=4 && concurrently --kill-others --restart-tries 3 --restart-delay 5000 \"npm run server\" \"npm run dev\" \"npm run airllm\" \"npm run creative\" \"npm run chroma\"",
    "start:docker": "set OLLAMA_BOOT_PROFILE=balanced && set OLLAMA_MAX_LOADED_MODELS=2 && concurrently --kill-others --restart-tries 3 --restart-delay 5000 \"npm run server\" \"npm run dev\" \"npm run creative\"",
    "build": "vite build",
    "lint": "eslint .",
    "test:stream": "node src/services/runStreamResultResolverTest.js && node --test --test-force-exit src/services/shortReplyVisualPacing.test.js",
    "test:e2e:runtime": "playwright test tests/e2e/runtime-chunks.spec.js",
    "preview": "vite preview",
    "citadel:smoke": "node server/src/scripts/smoke-test.js",
    "bootstrap": "node server/scripts/bootstrap-citadelle.mjs",
    "citadel:audit": "node server/src/scripts/audit-guards.js",
    "vault:audit": "cd server && npm run vault:audit",
    "security:audit:local": "npm run citadel:audit && cd server && npm run test:security && npm run quality:gate",
    "security:feedback": "node server/src/scripts/security-feedback-loop.js",
    "security:seed-history": "node server/src/scripts/seed-security-audit-history.js",
    "security:audit": "npm run security:audit:local && cd server && (npm audit --audit-level=high || node -e \"console.warn('[security:audit] npm audit ignore (reseau/SSL). Utilisez security:audit:local.')\")",
    "quality:gate": "cd server && npm run quality:gate",
    "conversation:daily-report": "cd server && npm run conversation:daily-report",
    "memory:daily-report": "cd server && npm run memory:daily-report",
    "ops:daily-report": "cd server && npm run ops:daily-report",
    "citadel:bench": "node server/src/scripts/benchmark-epistemic.js",
    "citadel:sync": "node server/src/scripts/sync-memory.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:debug": "playwright test --project=chromium --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "lucide-react": "^1.8.0",
    "mermaid": "^11.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  }
}
